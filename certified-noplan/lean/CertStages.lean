/-
CertStages — generator script (L4), NOT a build target and not part of a library.

  lake env lean --run CertStages.lean <name>  >  Certs/<Module>Kernel.lean

Writes the Lean source of a STAGED proof of `check <name> = true` for one certificate term of
`Certs/` (table `targets` below). Evaluating `check c` in the kernel in one go does not fit in
memory (journal L4: > 11 GB after two minutes on the smallest certificate). The staged proof
cuts the same evaluation into independent pieces — each a `by decide +kernel` of its own, hence
a kernel evaluation with its own memory — glued by the lemmas of `Certs/Staged.lean`:

  * the four global checks (0), (i), (ii), (0'), one evaluation each;
  * the kinematics `c.geometry` (numerators `N_k`, denominator `D`), equal to a literal `G`;
  * `T = δ² − φ²`, equal to a literal `T`;
  * per collision leaf: `Σλ ≡ 1`, `λ_k ≥ 0`, the witness `X = Σ λ_k N_k` equal to a literal,
    and ONE evaluation per obstacle face of the Bernstein test of `g_j − μ_j T`;
  * per outside leaf: its check, one evaluation.

The literals (`G`, `T`, `X`) are computed HERE, by compiled code, and are not trusted: each is
introduced by a theorem `… = literal` that the kernel checks by evaluating the left-hand side
itself. A wrong literal makes the generated file fail to compile; it cannot make a false
statement pass.
-/
import Certs.Staged
import Certs.WallK3
import Certs.S3ShoulderElbow
import Certs.S6IiwaRealShelf

open CnpVerify

/-- (definition name in `CnpVerify.Certs`, module of the term, the term). -/
def targets : List (String × String × Certificate) := [
  ("wallK3", "WallK3", Certs.wallK3),
  ("s3ShoulderElbow", "S3ShoulderElbow", Certs.s3ShoulderElbow),
  ("s6IiwaRealShelf", "S6IiwaRealShelf", Certs.s6IiwaRealShelf)]

def ratSrc (q : Rat) : String :=
  if q.den == 1 then (if q.num < 0 then s!"({q.num})" else s!"{q.num}")
  else s!"({q.num} : Rat) / {q.den}"

/-- Comma-separated items, wrapped at about 96 columns, continuation lines indented. -/
def wrapItems (indent : String) (items : List String) : String := Id.run do
  let mut out := ""
  let mut col := 0
  let mut first := true
  for it in items do
    if first then
      out := out ++ it
      col := it.length
      first := false
    else if col + it.length + 2 > 96 then
      out := out ++ ",\n" ++ indent ++ it
      col := it.length
    else
      out := out ++ ", " ++ it
      col := col + it.length + 2
  return out

def tensorSrc {n : Nat} (indent : String) (t : Tensor n) : String :=
  s!"⟨{t.deg}, #[\n{indent}  {wrapItems (indent ++ "  ") (t.coeffs.toList.map ratSrc)}]⟩"

def vec3Src {n : Nat} (indent : String) (v : Vector (Tensor n) 3) : String :=
  "#v[\n" ++ indent ++ "  "
    ++ (",\n" ++ indent ++ "  ").intercalate (v.toList.map (tensorSrc (indent ++ "  "))) ++ "]"

/-- `match j, hj with | 0, _ => p0 | … | j + N, hj => absurd` over `N` named proofs. -/
def cases (var size : String) (proofs : List String) : String :=
  let arms := proofs.zipIdx.map fun (p, k) => s!"    | {k}, _ => {p}"
  s!"fun {var} h{var} => match {var}, h{var} with\n" ++ "\n".intercalate arms
    ++ s!"\n    | {var} + {proofs.length}, h{var} => by rw [{size}] at h{var}; omega"

def emit (name modName : String) (c : Certificate) : IO Unit := do
  let n := c.n
  let geo := c.geometry
  let T := slabTensor c
  let p (s : String) : IO Unit := IO.println s
  p s!"/-
GENERATED by `lake env lean --run CertStages.lean {name}` — DO NOT EDIT.

Staged proof of `check {name} = true`, EVERY step of which is an evaluation by the Lean kernel
(`by decide +kernel`: no compiler, no `native_decide`, no axiom beyond the three standard
ones). What the stages are and why the proof is cut this way: `CertStages.lean`,
`Certs/Staged.lean`. The literals `G`, `T`, `X…` below are not trusted: each comes with a
theorem `… = literal` checked by the kernel.
-/
import Certs.Staged
import Certs.{modName}

namespace CnpVerify.Certs.{modName}Stages

open CnpVerify CnpVerify.Certs

-- One kernel evaluation at a time: the stages are independent, and elaborating them in
-- parallel would add up their memory.
set_option Elab.async false

abbrev c : Certificate := {name}

/-! ### Global checks (0), (i), (ii), (0') -/

theorem assumptions : checkAssumptions c = .ok () := by decide +kernel
theorem conditionI : checkConditionI c = .ok () := by decide +kernel
theorem partition : checkPartition c = .ok () := by decide +kernel
theorem kinematics : checkKinematics c = .ok () := by decide +kernel

/-! ### Kinematics: numerators of the body vertices, common denominator -/

def G : Geometry c.n where
  verts := #[
    {",\n    ".intercalate (geo.verts.toList.map (vec3Src "    "))}]
  den := {tensorSrc "    " geo.den}

theorem geometry_eq : c.geometry = G := by decide +kernel

/-! ### `T = δ² − φ²` -/

def T : Tensor c.n := {tensorSrc "  " T}

theorem slab_eq : slabTensor c = T := by decide +kernel

theorem lamDeg_eq : c.lamDeg = some {c.lamDeg.getD 0} := by decide +kernel
theorem leaves_size : c.leaves.size = {c.leaves.size} := by decide +kernel
"
  let dLam := c.lamDeg.getD 0
  let mut leafProofs : List String := []
  for h : i in [0:c.leaves.size] do
    let lf := c.leaves[i]
    match lf.kind with
    | .outside =>
      p s!"/-! ### Leaf {i}: outside -/

abbrev L{i} : Leaf c.n := c.leaves[{i}]

theorem L{i}_outside : checkOutsideLeaf c {i} L{i}.cell = .ok () := by decide +kernel

theorem L{i}_ok : checkLeaf c G {i} L{i} = .ok () :=
  checkLeaf_outside_of c G {i} L{i} (by decide +kernel) L{i}_outside
"
      leafProofs := leafProofs ++ [s!"L{i}_ok"]
    | .collision obstacle lam mu =>
      let some oi := c.obstacles.findIdx? (·.name == obstacle)
        | throw (IO.userError s!"leaf {i}: unknown obstacle {obstacle}")
      let obs := c.obstacles.getD oi ⟨"", #[]⟩
      let X := witnessNumerator lam geo.verts
      p s!"/-! ### Leaf {i}: collision with {obstacle} ({obs.faces.size} faces) -/

abbrev L{i} : Leaf c.n := c.leaves[{i}]
abbrev O{i} : Obstacle := c.obstacles[{oi}]

def X{i} : Vector (Tensor c.n) 3 := {vec3Src "  " X}

theorem L{i}_X : witnessNumerator L{i}.lam G.verts = X{i} := by decide +kernel
theorem L{i}_count : L{i}.lam.size = G.verts.size := by decide +kernel
theorem L{i}_sum :
    (L{i}.lam.foldl (init := Tensor.zero) (· + ·)).beqPoly (Tensor.const 1) = true := by
  decide +kernel
theorem L{i}_lam : ∀ k (hk : k < L{i}.lam.size),
    L{i}.lam[k].deg ≤ {dLam} ∧ bernNonneg L{i}.lam[k] {dLam} L{i}.cell {i} = .ok true := by
  decide +kernel
theorem L{i}_obs : c.obstacles.find? (·.name == L{i}.obstacle) = some O{i} := by decide +kernel
theorem L{i}_mu : L{i}.mu.size = O{i}.faces.size := by decide +kernel
theorem O{i}_faces : O{i}.faces.size = {obs.faces.size} := by decide +kernel
"
      let mut faceProofs : List String := []
      for j in [0:obs.faces.size] do
        p s!"theorem L{i}_face{j} : ¬ L{i}.mu.getD {j} 0 < 0 ∧
    bernNonneg (faceTensor G.den X{i} T O{i}.faces[{j}] (L{i}.mu.getD {j} 0))
      (max ({dLam} + 2) (2 * c.phiDeg)) L{i}.cell {i} = .ok true := by
  decide +kernel"
        faceProofs := faceProofs ++ [s!"L{i}_face{j}"]
      p s!"
theorem L{i}_ok : checkLeaf c G {i} L{i} = .ok () :=
  checkLeaf_collision_of c G {i} L{i} {dLam} O{i} X{i} T (by decide +kernel) lamDeg_eq L{i}_count
    L{i}_sum L{i}_lam L{i}_X L{i}_obs L{i}_mu slab_eq
    ({cases "j" s!"O{i}_faces" faceProofs})
"
      leafProofs := leafProofs ++ [s!"L{i}_ok"]
    | .undecided status =>
      throw (IO.userError s!"leaf {i}: status {status} — the checker rejects this certificate")
  p s!"/-! ### Assembly -/

theorem leaves_ok : ∀ i (hi : i < c.leaves.size), checkLeaf c G i c.leaves[i] = .ok () :=
  {cases "i" "leaves_size" leafProofs}

end CnpVerify.Certs.{modName}Stages

namespace CnpVerify.Certs

open {modName}Stages in
/-- **`check {name} = true`, evaluated by the kernel** (staged; see the header). -/
theorem {name}_proof : check {name} = true :=
  check_of_stages c G assumptions conditionI partition kinematics geometry_eq leaves_ok

end CnpVerify.Certs"

def main (args : List String) : IO UInt32 := do
  let [name] := args
    | do IO.eprintln "usage: lake env lean --run CertStages.lean <name>"; return 2
  match targets.find? (·.1 == name) with
  | none =>
    IO.eprintln s!"unknown certificate {name} (known: {targets.map (·.1)})"
    return 2
  | some (_, modName, c) =>
    emit name modName c
    return 0
